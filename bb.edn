{:paths ["src" "resources" "spec"]
 :deps {io.github.slagyr/isaac-agent {:git/url "https://github.com/slagyr/isaac-agent.git"
                                      :git/sha "2ed58f77d33d3f0ee72cb840401f793c97eba5e2"
                                      :exclusions [io.github.slagyr/isaac-foundation]}
        speclj/speclj {:mvn/version "3.13.0"}
        io.github.slagyr/gherclj {:git/tag "v1.4.0" :git/sha "85245b1"}
        io.github.slagyr/isaac-foundation-spec {:git/url "https://github.com/slagyr/isaac-foundation.git"
                                                :git/sha "d0b5ff547f1c98d68da26f3ef1503ed1acb32b2b"
                                                :deps/root "spec"}
        io.github.slagyr/isaac-foundation-test-support {:git/url "https://github.com/slagyr/isaac-foundation.git"
                                                        :git/sha "d0b5ff547f1c98d68da26f3ef1503ed1acb32b2b"
                                                        :deps/root "spec-support"}
        io.github.slagyr/isaac-agent-spec {:git/url "https://github.com/slagyr/isaac-agent.git"
                                           :git/sha "2ed58f77d33d3f0ee72cb840401f793c97eba5e2"
                                           :deps/root "spec"}}
 :tasks
 {spec {:task (shell "clojure" "-M:spec")}
  features {:task (apply shell "clojure" "-M:features" *command-line-args*)}
  ci {:task (do (run 'spec) (run 'features))}}}
